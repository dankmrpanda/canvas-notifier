# Canvas Notifier Bot Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application/Client ID (from Discord Developer Portal)
CLIENT_ID=your_client_id_here

# Canvas API Token (from Canvas Account Settings)
CANVAS_TOKEN=your_canvas_api_token_here

# =============================================================================
# COURSE CONFIGURATION
# =============================================================================
# You can configure courses in two ways:

# Option 1: Multiple courses (recommended)
# Format: courseId:channelId:roleId,courseId:channelId:roleId,...
# The roleId is optional - use courseId:channelId if you don't want role pings
# Example:
# COURSES=12345:111111111111111111:222222222222222222,67890:333333333333333333:444444444444444444

# Option 2: Single course (legacy format)
# COURSE_ID=your_course_id_here
# CHANNEL_ID=your_channel_id_here
# ROLE_ID=your_role_id_here

# =============================================================================
# EXAMPLES
# =============================================================================

# Single course with role ping:
# COURSES=12345:111111111111111111:222222222222222222

# Single course without role ping:
# COURSES=12345:111111111111111111

# Multiple courses:
# COURSES=12345:111111111111111111:222222222222222222,67890:333333333333333333:444444444444444444

# Multiple courses (some with roles, some without):
# COURSES=12345:111111111111111111:222222222222222222,67890:333333333333333333

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Canvas Base URL (defaults to canvas.cmu.edu)
CANVAS_BASE_URL=https://canvas.cmu.edu
